{
  "name": "aknet-cashier",
  "version": "1.0.0",
  "description": "AKNet - Man hinh quan ly order",
  "author": "AKNet",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.aknet.cashier",
    "productName": "AKNet Cashier",
    "directories": { "output": "dist" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AKNet Cashier"
    },
    "files": ["**/*", "!node_modules/.cache/**"],
    "publish": null,
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "electron": "^27.3.0",
    "electron-builder": "^24.9.1"
  }
}
